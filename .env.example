# Copy to .env to override defaults. Any setting in app/config.py can be set here.
DATABASE_URL=sqlite:///./testplatform.db

# Host names the API answers to. It has no logins yet, so keep this to the local machine.
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# Where workers check out code and build virtualenvs. Unset: the system temp folder.
# On Windows, keep it short: deep folders can push virtualenv files past the 260-character
# path limit.
# WORKSPACE_DIR=

# How often an idle worker checks for queued runs, in seconds.
WORKER_POLL_SECONDS=1

# Each run keeps the end of its log, up to this many bytes.
MAX_LOG_BYTES=200000

# Crash recovery. A worker sends a heartbeat this often while it executes a run. A run
# with no heartbeat for LEASE_SECONDS (at least 3 heartbeats) goes back to the queue,
# until it has been claimed MAX_ATTEMPTS times; then it is marked as an error.
HEARTBEAT_SECONDS=10
LEASE_SECONDS=60
MAX_ATTEMPTS=3
